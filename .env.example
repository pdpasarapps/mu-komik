NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://mu-komik.com

# Server-only: never expose these values to the browser.
SUPABASE_SERVICE_ROLE_KEY=
TRIPAY_MODE=sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_CALLBACK_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mu-komik-assets
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Required for Kids Mode. Signs the PIN cookie; Kids Mode answers 503 without it.
# Use at least 32 random characters (e.g. `openssl rand -base64 48`).
KIDS_MODE_COOKIE_SECRET=

# Google Analytics Data API (admin analytics panel). Escape newlines as \n.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
